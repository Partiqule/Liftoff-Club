# Optional. The app is built to run with none of these set.

# Public site URL used in calendar links, the sitemap, and share cards.
# Production uses https://liftoffclub.app when this is blank.
# liftoff-club.vercel.app still serves the app. Preview deploys use their own host.
NEXT_PUBLIC_SITE_URL=

# Optional Launch Library 2 token for a higher rate limit.
# Sent as: Authorization: Token <value>
# Never commit a real token. The free tier is cached and is enough for v1.
LL2_API_TOKEN=

# Optional model for the kid story and "ask about this launch".
# When EXPLAINER_API_KEY is empty, Liftoff Club
# writes the story and the answers from the launch data and does not call any model.
# The endpoint is OpenAI-compatible (chat completions).
# EXPLAINER_API_BASE defaults to https://api.openai.com/v1
EXPLAINER_API_KEY=
EXPLAINER_API_BASE=
EXPLAINER_MODEL=

# Phone alerts. Leave all of these blank and the phone alert controls stay hidden.
# Generate a VAPID pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: address or an https URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Upstash Redis REST, or the same values from a Vercel KV store.
# Used by phone alerts and by Pro early access. Leave blank and those features say they are not open.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Vercel sends this on the once daily backup cron. GitHub Actions does not use this secret.
# GitHub proves itself with an OIDC token for https://liftoffclub.app.
CRON_SECRET=

# Email when someone requests Pro early access, plus magic-link sign in. Both must be set, or no mail is sent. Do not put an address in code.
RESEND_API_KEY=
PRO_NOTIFY_EMAIL=
# Verified sender on the liftoffclub.app domain. Used for early access notes and for sign in links.
RESEND_FROM=
# Signs the Pro session cookie. Long random string. Required before sign in works. Never commit a real value.
PRO_SESSION_SECRET=
# Bearer token for GET /api/pro/access/export, and the token typed at /pro/admin.
ADMIN_TOKEN=
# Optional comma-separated emails that can open /pro/admin after they sign in. PRO_NOTIFY_EMAIL is included automatically.
ADMIN_EMAILS=
# Leave unset to approve a valid early access note immediately and email the sign in link.
# Set to false to hold new notes for /pro/admin.
PRO_AUTO_APPROVE=

# iPhone push. Leave blank and the app still opens. Alerts send only after all of these are set on Vercel.
# Create the key in Apple Developer, Keys. Download the .p8 once. Paste its contents here. Never commit the file.
# Newlines in the key can be written as \n. Team is 39AMCG49RK. Bundle is app.liftoffclub.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
# sandbox while you run from Xcode. Leave unset for the App Store build, which uses api.push.apple.com.
APNS_ENV=

# Optional FCC ECFS key for /pro/filings. When blank, a public demo key is used and the list is cached.
FCC_API_KEY=
